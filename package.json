{
  "name": "velora-wallpaper",
  "version": "0.1.0",
  "private": true,
  "description": "Personal wallpaper studio for Windows and Linux",
  "author": "Velora",
  "license": "GPL-3.0-or-later",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "vite build && electron-builder --win nsis --x64 --publish never",
    "dist:linux": "vite build && electron-builder --linux AppImage deb --x64 --publish never"
  },
  "dependencies": {
    "@google/genai": "2.18.0",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "koffi": "2.16.3",
    "lucide-react": "1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "vite": "8.3.2",
    "playwright": "1.63.0"
  },
  "build": {
    "appId": "studio.velora.wallpaper",
    "productName": "Velora",
    "executableName": "velora",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "desktop/**",
      "assets/**",
      "package.json",
      "NOTICE.txt"
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**",
      "node_modules/koffi/**",
      "node_modules/@img/**",
      "assets/**"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis"
      ],
      "artifactName": "Velora-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "allowElevation": false
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Utility",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "Velora-${version}-${arch}.${ext}",
      "maintainer": "Velora <noreply@velora.local>"
    },
    "afterPack": "scripts/after-pack.cjs"
  }
}
